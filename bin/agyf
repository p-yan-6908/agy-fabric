#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

find_bin() {
  local name="$1"
  shift
  for candidate in "$@"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  return 1
}

AGY_PATH="$(find_bin agy "${AGY_BIN:-}" "$HOME/.local/bin/agy" "/opt/homebrew/bin/agy" "/usr/local/bin/agy")" || {
  echo "agyf: could not find 'agy' binary in PATH or ~/.local/bin/agy" >&2
  exit 1
}

# Parse --plain flag (pass all other args straight through to agy)
PLAIN="${AGYF_PLAIN:-0}"
INLINE="${AGYF_INLINE:-0}"
USER_SETTINGS=0
PASSTHROUGH=()
USE_PROXY=1

if [ ! -t 0 ] || [ ! -t 1 ]; then
  USE_PROXY=0
fi

for arg in "$@"; do
  case "$arg" in
    --plain)
      PLAIN=1
      ;;
    --inline)
      INLINE=1
      ;;
    --settings|--settings=*)
      USER_SETTINGS=1
      PASSTHROUGH+=("$arg")
      ;;
    -p|--print|--prompt|--print=*|--prompt=*|-p=*|--output-format|--output-format=*|--help|-h|help|plugin|plugins|mcp|models|agent|agents|update|install|changelog|acp|remote-control|mic-serve)
      USE_PROXY=0
      PASSTHROUGH+=("$arg")
      ;;
    *)
      PASSTHROUGH+=("$arg")
      ;;
  esac
done

if [ "$PLAIN" = "1" ] || [ "$USE_PROXY" -eq 0 ]; then
  exec "$AGY_PATH" --agent fabric ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_SCRIPT=""
for candidate in   "${AGY_FABRIC_PLUGIN_DIR:-}/server/tui-proxy.mjs"   "$(dirname "$SCRIPT_DIR")/server/tui-proxy.mjs"   "$HOME/.gemini/config/plugins/fabric/server/tui-proxy.mjs"
do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    PROXY_SCRIPT="$candidate"
    break
  fi
done

# Full-screen (alternate screen) rendering by default under the compositor.
# Inline mode repaints with relative cursor moves over scrollback, which desyncs
# (duplicated/garbled rows) when the terminal reflows or the tab is backgrounded.
# Opt out with --inline / AGYF_INLINE=1, by passing your own --settings, or by
# saving an explicit `Rendering Mode` (altScreenMode) via /config.
SETTINGS_FILE="${AGY_SETTINGS_FILE:-$HOME/.gemini/antigravity-cli/settings.json}"
RENDER_ARGS=()
if [ "$INLINE" != "1" ] && [ "$USER_SETTINGS" -eq 0 ] \
  && ! grep -q '"altScreenMode"' "$SETTINGS_FILE" 2>/dev/null; then
  RENDER_ARGS=(--settings '{"altScreenMode":"always"}')
fi

BUN_PATH="$(find_bin bun "$HOME/.bun/bin/bun" "/opt/homebrew/bin/bun" "/usr/local/bin/bun" || true)"

if [ -n "$PROXY_SCRIPT" ] && [ -n "$BUN_PATH" ]; then
  exec "$BUN_PATH" "$PROXY_SCRIPT" "$AGY_PATH" --agent fabric ${RENDER_ARGS[@]+"${RENDER_ARGS[@]}"} ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
fi

exec "$AGY_PATH" --agent fabric ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
